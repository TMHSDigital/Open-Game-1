{
  "mcpServers": {
    "unreal": {
      "type": "http",
      "url": "http://127.0.0.1:8000/mcp"
    },
    "screencast": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@tmhs/screencast-mcp@0.54.0"]
    },
    "steam": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@tmhs/steam-mcp@0.10.0"],
      "env": {
        "STEAM_API_KEY": "<your-steam-web-api-key>",
        "STEAM_MCP_READ_ONLY": "1"
      }
    },
    "blender": {
      "_note": "Blender Lab MCP live session; see the 'Live Blender session' section of the Blender-Developer-Tools README. The commit is pinned: review a newer one before moving the pin.",
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://projects.blender.org/lab/blender_mcp.git@dbbf836ad4b1025f14a2b3b504c43903f39e0b04#subdirectory=mcp",
        "blender-mcp"
      ]
    }
  }
}
