# Copy to .env (gitignored). Never commit real values.
STEAM_APPID=
STEAM_DEPOT_WIN=
STEAM_BUILD_ACCOUNT=
STEAMCMD_PATH=
# Optional machine paths, read by tools/ue/env.ps1 (an environment variable of the same name wins).
# UE_ROOT: the Unreal Engine 5.8 folder. CS_PACKAGE_DIR: packaged build output, must end in \Windows.
UE_ROOT=
CS_PACKAGE_DIR=
