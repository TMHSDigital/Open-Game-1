Game/Plugins/*/Intermediate/
Game/.vs/
Game/*.sln
Game/*.VC.db
Game/*.opensdf
Game/*.sdf
Game/*.suo
Game/*.xcworkspace
*.pdb
*.log

# Packaged builds and staging
Packaged/
Staging/
dist/

# Blender
*.blend1
*.blend2
*.blend@

