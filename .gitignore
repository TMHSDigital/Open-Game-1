steam_appid.txt
steam/.depot-confirmed

# Generated per-run Steam build configs (contain real IDs)
app_build_*.vdf
depot_build_*.vdf
!steam/templates/*.vdf

# MCP client configs (local paths, ports); commit the .example instead
.mcp.json
!.mcp.json.example

# Unreal Engine (project lives in Game/)
Game/Binaries/
Game/DerivedDataCache/
Game/Intermediate/
Game/Saved/
